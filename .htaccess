# Bloquear acesso direto a arquivos sensíveis
<FilesMatch "^(config\.php|config\.example\.php|database\.sql)$">
  Require all denied
</FilesMatch>

<IfModule !mod_authz_core.c>
  <FilesMatch "^(config\.php|config\.example\.php|database\.sql)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Painel PHP (na raiz do repo)
  RewriteRule ^admin/ - [L]
  RewriteRule ^includes/ - [L]

  # Site buildado fica em /dist — mapear URLs públicas
  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]
  RewriteRule ^projects/(.*)$ dist/projects/$1 [L]
  RewriteRule ^(favicon\.svg|avatar\.jpg|icons\.svg)$ dist/$1 [L]
  RewriteRule ^(preview-[^/]+\.png)$ dist/$1 [L]

  # Home → build de produção (não o index.html do Vite)
  RewriteRule ^$ dist/index.html [L]

  # Arquivos/pastas reais na raiz
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback do portfólio
  RewriteCond %{REQUEST_URI} !^/admin
  RewriteRule ^ dist/index.html [L]
</IfModule>
